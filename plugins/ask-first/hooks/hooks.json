{
  "description": "Enforces the ask-first rules: one question per card with a marked recommendation, and no question left in prose at the end of a turn.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-card.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-prose.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
